    "helmet": "latest",
    "jsonwebtoken": "latest",
    "multer": "latest",
    "pg": "latest",
    "pg-mem": "^3.0.14",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sanitize-html": "latest",
    "tsx": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/compression": "^1.8.1",
