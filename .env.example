# ─────────────────────────────────────────────────────────────
# ThinkTank Academia — environment configuration
# Copy to .env for local development. Never commit real secrets.
# Every variable below is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# Database — REQUIRED in production (Turso / libsql)
# Create a database at https://turso.io, then use either:
#   DATABASE_URL=libsql://<username>:<password>@<database>.<org>.turso.io
#   DATABASE_URL=libsql://<auth-token>@<database>.<org>.turso.io   (or ?authToken=)
# Without it the API falls back to a local SQLite file (./data/thinktank.sqlite)
# for zero-configuration development, and to in-memory SQLite in tests.
DATABASE_URL=libsql://user:password@your-db.your-org.turso.io

# Security (REQUIRED in production)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Public URLs (REQUIRED in production — no localhost may be hardcoded)
# PUBLIC_URL   = where this service is reachable (used for sitemap, links, emails)
# FRONTEND_URL = comma separated list of allowed CORS origins
PUBLIC_URL=https://thinktank-academia.onrender.com
FRONTEND_URL=https://thinktank-academia.onrender.com

# ── Super Admin (the account that owns the admin console) ──────────────────
# The SUPER_ADMIN account is seeded on first boot from these variables.
# It is the only role that can manage every other administrator.
SUPER_ADMIN_EMAIL=admin@thinktankacademia.org
SUPER_ADMIN_PASSWORD=replace-with-a-strong-initial-password
SUPER_ADMIN_NAME=Administrator

# Legacy administrator variables — still honoured. If different from
# SUPER_ADMIN_* they are seeded as an additional SUPER_ADMIN account.
ADMIN_EMAIL=admin@thinktankacademia.org
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_NAME=Administrator

# Seed the starter library (categories are always seeded).
# Set to false for a completely empty installation.
SEED_DEMO_CONTENT=true

# ── Hacker Admin (emergency operations console at /hackeradmin) ────────────
# A passcode is generated automatically and e-mailed through SMTP below.
# The passcode changes on its own after the TTL (default: 60 minutes) and a
# fresh e-mail is sent with every new code.
HACKER_ADMIN_ENABLED=true
# Where the hourly passcode is e-mailed:
HACKER_ADMIN_EMAIL=mdmoshiurrahmanmohi1@gmail.com
# Passcode lifetime in minutes (default 60 — "changes in 1 hour"):
HACKER_ADMIN_PASSCODE_TTL_MINUTES=60
# Development-only fixed passcode (ignored in production). Handy when SMTP
# is not configured yet:
#HACKER_ADMIN_DEV_PASSCODE=
# Max passcode attempts per IP per 15 minutes:
HACKER_ADMIN_MAX_ATTEMPTS=10

# ── SMTP (REQUIRED for passcode e-mails & password resets) ─────────────────
# Without SMTP the app still runs: reset links are returned in the response
# in development, and the hacker-admin passcode is logged by the dev passcode
# fallback instead of being e-mailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="ThinkTank Academia <no-reply@thinktankacademia.org>"

# Media storage. driver = local | s3
#   local : writes to ./uploads (development only — Render disks are ephemeral)
#   s3    : any S3-compatible object store (AWS S3, Cloudflare R2, DigitalOcean
#           Spaces, Backblaze B2, MinIO, Supabase Storage). Uses SigV4 signed PUT,
#           no SDK required. This is the recommended production driver.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=thinktank-academia
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional path prefix inside the bucket
STORAGE_PREFIX=media
# Public base URL for stored objects (CDN / public bucket URL)
STORAGE_PUBLIC_URL=https://media.thinktankacademia.org
# Maximum upload size in megabytes
MAX_UPLOAD_MB=5

# Android / web push (FCM HTTP v1). Optional — in-app notifications work without it.
# Provide a Firebase service account to enable real push delivery.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
