# ─────────────────────────────────────────────────────────────
# ThinkTank Academia — environment configuration
# Copy to .env for local development. Never commit real secrets.
# Every variable below is optional unless marked REQUIRED.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# Database (REQUIRED in production — Render supplies this automatically)
# Without it the API falls back to an in-memory PostgreSQL-compatible
# database (pg-mem) so local development and tests work with zero setup.
DATABASE_URL=postgresql://user:password@host:5432/thinktank

# Security (REQUIRED in production)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Public URLs (REQUIRED in production — no localhost may be hardcoded)
# PUBLIC_URL   = where this service is reachable (used for sitemap, links, emails)
# FRONTEND_URL = comma separated list of allowed CORS origins
PUBLIC_URL=https://thinktank-academia.onrender.com
FRONTEND_URL=https://thinktank-academia.onrender.com

# First administrator, seeded once on boot if the address does not exist.
# The password is hashed with bcrypt and never written to the logs.
ADMIN_EMAIL=admin@thinktankacademia.org
ADMIN_PASSWORD=replace-with-a-strong-initial-password
ADMIN_NAME=Administrator

# Seed the starter library (categories are always seeded).
# Set to false for a completely empty installation.
SEED_DEMO_CONTENT=true

# Media storage. driver = local | s3
#   local : writes to ./uploads (development only — Render disks are ephemeral)
#   s3    : any S3-compatible object store (AWS S3, Cloudflare R2, DigitalOcean
#           Spaces, Backblaze B2, MinIO, Supabase Storage). Uses SigV4 signed PUT,
#           no SDK required. This is the recommended production driver.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=thinktank-academia
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional path prefix inside the bucket
STORAGE_PREFIX=media
# Public base URL for stored objects (CDN / public bucket URL)
STORAGE_PUBLIC_URL=https://media.thinktankacademia.org
# Maximum upload size in megabytes
MAX_UPLOAD_MB=5

# Transactional email (password reset). Without SMTP the API still works:
# reset links are returned in the response in development and logged there.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ThinkTank Academia <no-reply@thinktankacademia.org>"

# Android / web push (FCM HTTP v1). Optional — in-app notifications work without it.
# Provide a Firebase service account to enable real push delivery.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
